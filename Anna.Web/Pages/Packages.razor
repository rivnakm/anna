@page "/"
@using Anna.Client.Models
@using Anna.Common.Models.SearchQueryService
@inject IAnnaClient AnnaClient

<PageTitle>Anna | Packages</PageTitle>

<MudTable Items="@this.AllPackages" Loading="@this._loading">
    <HeaderContent>
        <MudTh>Id</MudTh>
        <MudTh>Version</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Id">@context.Id</MudTd>
        <MudTd DataLabel="Version">@context.Version</MudTd>
    </RowTemplate>
</MudTable>

@code
{
    private List<SearchResult> AllPackages { get; } = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var response = await this.AnnaClient.Search(new SearchRequest());
        this.AllPackages.AddRange(response.Results);
        this._loading = false;
    }
}
